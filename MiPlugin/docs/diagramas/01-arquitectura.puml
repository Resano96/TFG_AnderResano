@startuml
actor Usuario
package "Revit 2025" {
  [Cinta de opciones]
  [API de Revit]
  database "Modelo" as M
}
package "MiPlugin" {
  [App / Ribbon]
  [Commands]
  [Lectores de Revit]
  [UI (WPF + MVVM)]
}
package "MiPlugin.Core" {
  [Models]
  [Services]
  [Interfaces]
}
[MiPlugin.Tests]
file "Excel / JSON" as F

Usuario --> [Cinta de opciones]
[Cinta de opciones] --> [Commands]
[App / Ribbon] --> [Cinta de opciones]
[Commands] --> [Lectores de Revit]
[Commands] --> [Services]
[Commands] --> [UI (WPF + MVVM)]
[Lectores de Revit] --> [API de Revit]
[API de Revit] --> M
[Lectores de Revit] ..|> [Interfaces]
[Services] --> [Models]
[Services] --> F
[MiPlugin.Tests] --> [Services]
@enduml
